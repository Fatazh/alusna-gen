# Copy this file to .env.production and replace both values before release.
VITE_SITE_URL=https://alusna.example
VITE_CONTACT_EMAIL=hello@alusna.example

# Keep analytics and advertising disabled until their privacy review is complete.
VITE_ANALYTICS_ENABLED=false

# Cookieless GA4 stays fully off unless ALL THREE hold: the visitor approves the
# consent banner, VITE_ANALYTICS_ENABLED=true, and VITE_GA4_ID is a valid
# G-XXXXXXXXXX measurement ID. Leave it commented out to keep GA4 disabled.
# VITE_GA4_ID=G-XXXXXXXXXX
