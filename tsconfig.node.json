{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".vite-config-types",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "src/app/content/toolGuides.ts",
    "src/app/router/routes.ts",
    "src/app/seo/staticPageContent.ts",
    "src/shared/config/brand.ts"
  ]
}
