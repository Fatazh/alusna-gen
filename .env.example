# URL publik tanpa trailing slash. Dipakai untuk canonical URL dan sitemap.
VITE_SITE_URL=https://domain-anda.com

# Kontak publik yang ditampilkan di halaman kebijakan. Kosongkan sampai siap dipublikasikan.
