# URL publik tanpa trailing slash. Dipakai untuk canonical URL dan sitemap.
VITE_SITE_URL=https://domain-anda.com

# Kontak publik yang ditampilkan di halaman kebijakan. Kosongkan sampai siap dipublikasikan.
VITE_CONTACT_EMAIL=halo@domain-anda.com

# Slot sponsor langsung/affiliate. Slot otomatis disembunyikan jika kosong.
VITE_SPONSOR_URL=https://sponsor-atau-affiliate.com
VITE_SPONSOR_TITLE=Nama sponsor
VITE_SPONSOR_TEXT=Deskripsi singkat dan jujur tentang sponsor.

# Tombol dukung/donasi di header (opsional, terpisah dari slot sponsor).
# Slot disembunyikan jika salah satu kosong.
VITE_SUPPORT_URL=https://trakteer.id/alusna/tip
VITE_SUPPORT_TITLE=Trakteer

# Analitik tanpa cookie (GA4). Mati total kecuali KETIGA variabel di bawah ini
# terisi dengan benar: banner persetujuan ditampilkan, analytics diaktifkan,
# dan ID pengukuran GA4 valid (format G-XXXXXXXXXX).
VITE_ANALYTICS_ENABLED=false
# VITE_GA4_ID=G-XXXXXXXXXX
