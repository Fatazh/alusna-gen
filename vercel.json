{
  "buildCommand": "npm run build:production",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/((?!en/).*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/robot.txt",
      "destination": "/robots.txt",
      "permanent": true
    }
  ]
}
